rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reports/{reportId} {
      allow create: if request.resource.data.keys().hasOnly(['title', 'body', 'labels', 'status', 'createdAt'])
                    && request.resource.data.keys().hasAll(['title', 'body', 'status', 'createdAt'])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() <= 5000
                    && request.resource.data.status == 'new'
                    && request.resource.data.createdAt == request.time
                    && (!('labels' in request.resource.data)
                        || (request.resource.data.labels is list
                            && request.resource.data.labels.size() <= 5
                            && request.resource.data.labels.hasOnly([
                              'needs-research',
                              'wrong-information',
                              'wrong-info',
                              'issue-report',
                              'bird-request',
                              'profile-request'
                            ])));
      allow read, update, delete: if false;
    }
  }
}
